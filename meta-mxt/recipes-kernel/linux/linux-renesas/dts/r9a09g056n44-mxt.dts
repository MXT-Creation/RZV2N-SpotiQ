/dts-v1/;
#include "r9a09g056.dtsi"
#include <dt-bindings/pinctrl/rzg2l-pinctrl.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Renesas EVK based on r9a09g056n44";
	compatible = "renesas,r9a09g056n44-evk", "renesas,r9a09g056n44", "renesas,r9a09g056";

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c3 = &i2c3;
		serial0 = &scif;
		serial1 = &sci0;
		serial2 = &sci1;
		mmc0 = &sdhi0;
		mmc1 = &sdhi1;
		ethernet0 = &eth0;
		ethernet1 = &eth1;
	};

	chosen {
		bootargs = "ignore_loglevel";
		stdout-path = "serial0:115200n8";
	};

	memory@48000000 {
		device_type = "memory";
		/* first 128MB is reserved for secure area. */
		reg = <0x0 0x48000000 0x1 0xF8000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		global_cma: linux,cma@58000000 {
			compatible = "shared-dma-pool";
			linux,cma-default;
			reusable;
			reg = <0x0 0x58000000 0x0 0x28000000>;
		};

		mmp_reserved: linux,multimedia {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x00000000 0x80000000 0x0 0x10000000>;
		};

		isp_reserved: frame_buffer@90000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0x90000000 0x0 0x18000000>;
		};

		opencva_reserved: OpenCVA@A8000000 {
			reusable;
			reg = <0x0 0xA8000000 0x0 0x7CFF000>;
		};

		shared_drp_reserved: SharedDRP@AFCFF000 {
			reusable;
			reg = <0x0 0xAFCFF000 0x0 0x00001000>;
		};

		drp_codec: DRP-Codec@AFD00000 {
			reusable;
			reg = <0x0 0xAFD00000 0x0 0x300000>;
		};

		image_buf0: image_buf@B0000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0xB0000000 0x0 0x4000000>;
			label = "image_buf0";
		};

		cru_func: cru_buffer@B4000000 {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x0 0xB4000000 0x0 0x16400000>;
		};

		drp_reserved: DRP-AI@D0000000 {
			reusable;
			reg = <0x0 0xD0000000 0x0 0x20000000>;
		};
	};

	mmngr {
		compatible = "renesas,mmngr";
		memory-region = <&mmp_reserved>;
	};

	mmngrbuf {
		compatible = "renesas,mmngrbuf";
	};

	vspm_if {
		compatible = "renesas,vspm_if";
	};

       x1_clk: x1-clock {
               compatible = "fixed-clock";
               #clock-cells = <0>;
               clock-frequency = <24000000>;
       };

	reg_1p8v: regulator0 {
		compatible = "regulator-fixed";

		regulator-name = "fixed-1.8V";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_3p3v: regulator1 {
		compatible = "regulator-fixed";

		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-boot-on;
		regulator-always-on;
	};

	vccq_sdhi0: regulator-vccq-sdhi0 {
		compatible = "regulator-gpio";

		regulator-name = "SDHI0 VccQ";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;

		gpios = <&pinctrl RZG2L_GPIO(10, 0) GPIO_ACTIVE_HIGH>;

		gpios-states = <1>;
		states = <3300000 0 1800000 1>;
	};

	vccq_sdhi1: regulator-vccq-sdhi1 {
		compatible = "regulator-gpio";

		regulator-name = "SDHI1 VccQ";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <3300000>;

		gpios = <&pinctrl RZG2L_GPIO(10, 2) GPIO_ACTIVE_HIGH>;

		gpios-states = <1>;
		states = <3300000 0 1800000 1>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";

		nmi {
			interrupt-parent = <&icu>;
			interrupts = <0 IRQ_TYPE_EDGE_FALLING>;
			linux,code = <4>;
			label = "NMI";
			wakeup-source;
		};
	};

	edp_refclk: edp_refclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <19200000>;
	};
	
	dp-out {
		compatible = "dp-connector";
		label = "miniDP";

		port {
			dp_con_out: endpoint {
				remote-endpoint = <&tc358767_out>;
			};
		};
	};
	
	soc: soc {
		rsci_i2c6: i2c@12802400 {
			compatible = "renesas,r9a09g056-rz-rsci",
				     "renesas,rsci-i2c";
			reg = <0 0x12802400 0 0x400>;
			interrupts = <GIC_SPI 150 IRQ_TYPE_LEVEL_HIGH>,
					<GIC_SPI 151 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 152 IRQ_TYPE_EDGE_RISING>,
					<GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "eri", "rxi", "txi", "tei";
			clocks = <&cpg CPG_MOD 0x7b>, <&cpg CPG_MOD 0x7c>;
			clock-names = "fck", "tclk";
			power-domains = <&cpg>;
			resets = <&cpg 0x8d>, <&cpg 0x8e>;
			reset-names = "presetn", "tresetn";
			status = "disabled";
		};
	};
	
	vpcie3v3: regulator-vpcie3v3 {
	        compatible = "regulator-fixed";
	        regulator-name = "vpcie3v3";
	        regulator-min-microvolt = <3300000>;
	        regulator-max-microvolt = <3300000>;

	        gpios = <&pinctrl RZG2L_GPIO(0, 0) GPIO_ACTIVE_HIGH>;  /* PWR_EN */
	        enable-active-high;
	        regulator-boot-on;
	        regulator-always-on;
	};
};

&du {
	status = "okay";
};

&dsi0 {
	status = "okay";

	ports {
		port@1 {
			dsi0_out: endpoint {
				remote-endpoint = <&tc358767_in>;
				data-lanes = <0 1 2 3>;
			};
		};
	};
};

&eth0 {
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		phy0: ethernet-phy@0 {
			compatible = "ethernet-phy-id0022.1640",
				     "ethernet-phy-ieee802.3-c22";
			reg = <0>;
			rxc-skew-psec = <1400>;
			txc-skew-psec = <1400>;
			rxdv-skew-psec = <0>;
			txdv-skew-psec = <0>;
			rxd0-skew-psec = <0>;
			rxd1-skew-psec = <0>;
			rxd2-skew-psec = <0>;
			rxd3-skew-psec = <0>;
			txd0-skew-psec = <0>;
			txd1-skew-psec = <0>;
			txd2-skew-psec = <0>;
			txd3-skew-psec = <0>;
		};
	};
};

&audio_clka {
	clock-frequency = <22579200>;
};

&audio_clkb {
	clock-frequency = <24576000>;
};

&audio_clkc {
	clock-frequency = <22579200>;
};

&pinctrl {
	i2c3_pins: i2c3 {
		pinmux = <RZG2L_PORT_PINMUX(3, 6, 1)>, /* I2C3_SDA */
			 <RZG2L_PORT_PINMUX(3, 7, 1)>; /* I2C3_SCL */
	};

	scif0_pins: scif0 {
		pins =  "SCIF_TXD", "SCIF_RXD";
		renesas,output-impedance = <1>;
	};

	sd0_pwr_en {
		gpio-hog;
		gpios = <RZG2L_GPIO(10, 1) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sd0_pwr_en";
	};

	sd1_pwr_en {
		gpio-hog;
		gpios = <RZG2L_GPIO(10, 3) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sd1_pwr_en";
	};

	/* Support pinctrl for SD function of SDHI0 */
	sdhi0_pins: sd0 {
		sd0_mux {
			pinmux = <RZG2L_PORT_PINMUX(10, 5, 15)>; /* SD0_CD */
		};
	};

	/* Support pinctrl for SD function of SDHI1 */
	sdhi1_pins: sd1 {
		sd1_mux {
			pinmux = <RZG2L_PORT_PINMUX(9, 4, 14)>; /* SD1_CD */
		};
	};

	usb20_pins: usb20 {
		pinmux = <RZG2L_PORT_PINMUX(9, 5, 14)>, /* VBUS */
			 <RZG2L_PORT_PINMUX(9, 6, 14)>; /* OVC */
	};

	i2c0_pins: i2c0 {
		pinmux = <RZG2L_PORT_PINMUX(3, 0, 1)>, /* I2C0_SDA */
			 <RZG2L_PORT_PINMUX(3, 1, 1)>; /* I2C0_SCL */
	};

	i2c1_pins: i2c1 {
		pinmux = <RZG2L_PORT_PINMUX(3, 2, 1)>, /* I2C1_SDA */
			 <RZG2L_PORT_PINMUX(3, 3, 1)>; /* I2C1_SCL */
	};

	i2c2_pins: i2c2 {
		pinmux = <RZG2L_PORT_PINMUX(2, 0, 4)>, /* I2C2_SDA */
			 <RZG2L_PORT_PINMUX(2, 1, 4)>; /* I2C2_SCL */
	};

       rsci_i2c6_pins: rsci_i2c6 {
               pinmux = <RZG2L_PORT_PINMUX(9, 0, 2)>, /* SCI8_RXD_MISO_SCL */
                        <RZG2L_PORT_PINMUX(9, 1, 2)>; /* SCI8_TXD_MOSI_SDA */
                        drive-open-drain = <1>;
       };

	spi2_pins: spi2 {
		pinmux = <RZG2L_PORT_PINMUX(11, 3, 5)>, /* MISO */
			 <RZG2L_PORT_PINMUX(11, 4, 5)>, /* MOSI */
			 <RZG2L_PORT_PINMUX(10, 7, 5)>, /* SSL */
			 <RZG2L_PORT_PINMUX(11, 5, 5)>; /* RSPCK */
	};

	/* cam0_pwr_en is used by Google Coral Camera from CSI20 and CSI21 */
	cam0_pwr_en {
		gpio-hog;
		gpios = <RZG2L_GPIO(11, 2) GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "cam0_pwr_en";
	};

	sound_clk_pins: sound_clk {
		pinmux = <RZG2L_PORT_PINMUX(1, 0, 7)>, /* AUDIO_CLKB */
			 <RZG2L_PORT_PINMUX(1, 1, 7)>, /* AUDIO_CLKC */
			 <RZG2L_PORT_PINMUX(9, 7, 8)>; /* AUDIO_CLKOUT */
	};

	sound_pins: sound {
		pinmux = <RZG2L_PORT_PINMUX(1, 2, 7)>, /* SSI3_SCK */
			 <RZG2L_PORT_PINMUX(1, 3, 7)>, /* SSI3_WS */
			 <RZG2L_PORT_PINMUX(0, 4, 7)>, /* SSI3_SDATA */
			 <RZG2L_PORT_PINMUX(1, 5, 7)>; /* SSI4_SDATA */
	};

	sci0_pins: sci0 {
		pinmux = <RZG2L_PORT_PINMUX(5, 0, 1)>, /* SCI0_TXD_MOSI_SDA */
			<RZG2L_PORT_PINMUX(5, 1, 1)>; /* SCI0_RXD_MISO_SCL */
		bias-pull-up;
	};

	sci1_pins: sci1 {
		pinmux = <RZG2L_PORT_PINMUX(5, 2, 1)>, /* SCI1_TXD_MOSI_SDA */
			<RZG2L_PORT_PINMUX(5, 3, 1)>; /* SCI1_RXD_MISO_SCL */
		bias-pull-up;
	};
};

&qextal_clk {
	clock-frequency = <24000000>;
};

&scif {
	pinctrl-0 = <&scif0_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&ostm0 {
	status = "okay";
};

&ostm1 {
	status = "okay";
};

&wdt1 {
	status = "okay";
};

&sdhi0 {
	pinctrl-0 = <&sdhi0_pins>;
	pinctrl-names = "default";

	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&vccq_sdhi0>;

	bus-width = <4>;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	status = "okay";
};

&sdhi1 {
	pinctrl-0 = <&sdhi1_pins>;
	pinctrl-names = "default";

	vmmc-supply = <&reg_3p3v>;
	vqmmc-supply = <&vccq_sdhi1>;
	bus-width = <4>;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	status = "okay";
};

&drp1 {
    memory-region = <&drp_codec>;
    memory-oca-region = <&opencva_reserved>;
    memory-shared-for-drpai-ext-cont = <&shared_drp_reserved>;
    status = "okay";
};

&rtc {
        status = "okay";
};

&ohci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	status = "okay";
};

&ehci0 {
	memory-region = <&global_cma>;
	dr_mode = "otg";
	status = "okay";
};

&hsusb {
	dr_mode = "otg";
	status = "okay";
};

&usb20phyrst {
	status = "okay";
};

&usb2_phy0 {
	pinctrl-0 = <&usb20_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&usb3_phy0 {
	status = "okay";
};

&xhci0 {
	memory-region = <&global_cma>;
	status = "okay";
};

&i2c0 {
	pinctrl-0 = <&i2c0_pins>;
	pinctrl-names = "default";

	status = "okay";
        clock-frequency = <400000>;
        
        tevs_csi20: tevs_csi20@48 {
		compatible = "tn,tevs";
		reg = <0x48>;

		continuous-clock = <0>;
		data-lanes = <2>;
		data-frequency = <800>;
		//hw-reset; // keep the camera off, when unused
		
		host-pwdn-gpios = <&pinctrl RZG2L_GPIO(3, 5) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZG2L_GPIO(3, 4) GPIO_ACTIVE_LOW>;

		port {
			tevs_to_csi20: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&csi20_in>;
			};
		};
	}; 
};

&cru0 {
	status = "okay";
};

&csi20 {
	status = "okay";

	ports {
		port {
			csi20_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&tevs_to_csi20>;
			};
		};
	};
};

&i2c1 {
	pinctrl-0 = <&i2c1_pins>;
	pinctrl-names = "default";

        status = "okay";
        clock-frequency = <400000>;

        tevs_csi21: tevs_csi21@48 {
		compatible = "tn,tevs";
		reg = <0x48>;

		continuous-clock = <0>;
		data-lanes = <2>;
		data-frequency = <800>;
		//hw-reset; // keep the camera off, when unused
		
		host-pwdn-gpios = <&pinctrl RZG2L_GPIO(3, 7) GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pinctrl RZG2L_GPIO(3, 6) GPIO_ACTIVE_LOW>;

		port {
			tevs_to_csi21: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&csi21_in>;
			};
		};
	};
};

&cru1 {
	status = "okay";
};

&csi21 {
	status = "okay";

	ports {
		port {
			csi21_in: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				remote-endpoint = <&tevs_to_csi21>;
			};
		};
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_pins>;
	pinctrl-names = "default";

	status = "okay";

	tc358767: dp-bridge@68 {
		compatible = "toshiba,tc358767";
		reg = <0x68>;
		clock-names = "ref";
		clocks = <&edp_refclk>;
		toshiba,hpd-pin = <0>;
		interrupt-parent = <&icu>;
		interrupts = <RZG2L_GPIO(10, 2) IRQ_TYPE_LEVEL_LOW>;
		reset-gpios = <&pinctrl RZG2L_GPIO(10, 6) GPIO_ACTIVE_LOW>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				tc358767_in: endpoint {
					remote-endpoint = <&dsi0_out>;
					data-lanes = <0 1 2 3>;
				};
			};

			port@2 {
				reg = <2>;
				tc358767_out: endpoint {
					remote-endpoint = <&dp_con_out>;
				};
			};
		};
	};
};

&rsci_i2c6 {
       pinctrl-0 = <&rsci_i2c6_pins>;
       pinctrl-names = "default";

       status = "okay";
       
       #address-cells = <1>;
       #size-cells = <0>;

       versa3: versa3@69 {
               compatible = "renesas,5p35023";
               reg = <0x69>;
               #clock-cells = <1>;
               clocks = <&x1_clk>;
               clock-names = "x1";
               assigned-clocks = <&versa3 5>,
                                 <&versa3 4>,
                                 <&versa3 3>,
                                 <&versa3 2>,
                                 <&versa3 1>,
                                 <&versa3 0>;
               assigned-clock-rates =  <100000000>, <100000000>,
                                       <22579200>, <32768>,
                                       <24576000>, <24000000>;
               clock-divider-read-only = <1>, <1>, <1>, <1>, <1>;
               clock-flags = <2176>, <2176>, <2176>, <2052>, <2176>, <2048>;
       };
};

&adc0 {
	status = "okay";
};

&adc1 {
	status = "okay";
};

&adc2 {
	status = "okay";
};

&cmtw0 {
	status = "okay";
};

&cmtw1 {
	status = "okay";
};

&rcar_sound {
	pinctrl-0 = <&sound_clk_pins &sound_pins>;
	pinctrl-names = "default";

	status = "okay";

	/* audio_clkout */
	#clock-cells = <0>;
	clock-frequency = <11289600>;

	/* Multi DAI */
	#sound-dai-cells = <1>;

	rcar_sound,dai {
		dai0 {
			playback = <&ssi3>;
			capture  = <&ssi4 &src0 &dvc0>;
		};
	};
};

&ssi4 {
	shared-pin;
};

&pcie0 {
	/* Map all possible DDR as inbound ranges */
	dma-ranges = <0x42000000 0 0x40000000 0 0x40000000 0x2 0x00000000>;

	status = "okay";
	vpcie-supply = <&vpcie3v3>;
};

&sci0 {
        pinctrl-0 = <&sci0_pins>;
        pinctrl-names = "default";
        status = "okay";

};

&sci1 {
        pinctrl-0 = <&sci1_pins>;
        pinctrl-names = "default";
        status = "okay";

};

&drpai0 {
	memory-region = <&drp_reserved>;
	memory-shared-for-drpai-ext-cont = <&shared_drp_reserved>;
	status = "okay";
};
