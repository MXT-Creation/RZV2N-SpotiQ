+		tc->panel_bridge = bridge;
+		tc->bridge.type = DRM_MODE_CONNECTOR_DPI;
+		tc->bridge.funcs = &tc_dpi_bridge_funcs;
+
+		return 0;
+	}
+	pr_err("%s %d\n", __func__, __LINE__);
+
+	return ret;
+}
