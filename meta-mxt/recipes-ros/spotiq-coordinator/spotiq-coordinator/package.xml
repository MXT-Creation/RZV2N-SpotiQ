<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spotiq_coordinator</name>
  <version>0.1.0</version>
  <description>
    SpotiQ Coordinator — ROS 2 Humble node that bridges Vosk voice commands,
    darknet_drp_ros AI inference results and the UFACTORY Lite6 robot arm.
    Runs on the PC side; the AI inference runs on the RZV2N (spotiq) board.
  </description>

  <maintainer email="you@mxt.ro">MXT / SpotiQ</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>xarm_msgs</depend>
  <depend>darknet_ros_msgs</depend>
  <!-- voskros srv — if not installed, grammar is set manually via CLI -->
  <depend>voskros</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
