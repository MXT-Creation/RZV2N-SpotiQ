+	.items = rzg2l_gpt_counter_modes,
+	.num_items = ARRAY_SIZE(rzg2l_gpt_counter_modes),
+	.get = rzg2l_gpt_get_counter_mode,
+	.set = rzg2l_gpt_set_counter_mode,
+};
