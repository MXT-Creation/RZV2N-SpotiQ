-				GTINTAD_OUTPUT_DISABLE_GRP_MASK, GTINTAD);
-		/* Set output disable source */
-		if (pc->gpt_operation == DEADTIME_OUTPUT)
-			rzg2l_gpt_write_mask(pc,
