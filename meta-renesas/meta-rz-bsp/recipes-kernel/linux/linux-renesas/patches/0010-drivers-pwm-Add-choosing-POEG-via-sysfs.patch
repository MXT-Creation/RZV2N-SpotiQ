-		else
-			rzg2l_gpt_write_mask(pc,
-				OUTPUT_DISABLE_SAME_LEVEL_HIGH|
-				OUTPUT_DISABLE_SAME_LEVEL_LOW,
-				GTINTAD_OUTPUT_DISABLE_POEG_MASK, GTINTAD);
-		/* Enable pin output disable */
