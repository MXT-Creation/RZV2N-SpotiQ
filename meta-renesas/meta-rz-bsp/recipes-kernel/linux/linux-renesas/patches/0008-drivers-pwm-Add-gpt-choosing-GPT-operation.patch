+	"normal_output",
+	"single_buffer_output",
+	"double_buffer_output",
+	"deadtime_output",
+	"input_capture",
+};
+
+enum {
+	NORMAL_OUTPUT,
+	SINGLE_BUFFER_OUTPUT,
+	DOUBLE_BUFFER_OUTPUT,
+	DEADTIME_OUTPUT,
+	INPUT_CAPTURE,
+};
+
 enum {
