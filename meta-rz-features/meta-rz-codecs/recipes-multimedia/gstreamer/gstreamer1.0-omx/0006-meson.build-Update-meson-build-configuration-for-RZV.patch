From 821d2e06bbe4435194f83bd42ae9d417f51664bd Mon Sep 17 00:00:00 2001
From: Hung Thanh Huynh <hung.huynh.wz@renesas.com>
Date: Mon, 19 Feb 2024 16:43:57 +0900
Subject: [PATCH 06/17] meson.build: Update meson build configuration for RZV2H

HEVC support of RZV2H need special header.

Signed-off-by: Hung Thanh Huynh <hung.huynh.wz@renesas.com>
---
 meson.build     | 25 +++++++++++++++++++++++++
 omx/meson.build |  6 ++++++
 2 files changed, 31 insertions(+)

diff --git a/meson.build b/meson.build
index 8da27ca..74c1ee7 100644
--- a/meson.build
+++ b/meson.build
@@ -289,6 +289,13 @@ elif omx_target == 'rcar'
     cdata.set ('HAVE_VIDEOR_EXT', 1)
   endif
 
+  # check OMXR_Extension_h264.h
+  if cc.has_header (
+      'OMXR_Extension_h264.h',
+      args : gst_omx_args)
+    cdata.set ('HAVE_H264_EXT', 1)
+  endif
+
   # check OMXR_Extension_h265d.h
   if cc.has_header (
       'OMXR_Extension_h265d.h',
@@ -386,6 +393,24 @@ if have_omx_hevc
   cdata.set('HAVE_HEVC', 1)
 endif
 
+if  target_device == 'rzv2h'
+  have_hevc_ext = cc.has_header_symbol(
+      'OMXR_VideoExt.h',
+      'OMX_VIDEO_CodingHEVC',
+      prefix : extra_video_headers,
+      args : gst_omx_args,
+      include_directories : [omx_inc])
+    if have_hevc_ext
+      cdata.set('HAVE_HEVC_EXT', 1)
+    endif
+  have_hevc_enc = cc.has_header(
+      'OMXR_Extension_h265e.h',
+      args : gst_omx_args)
+    if have_hevc_enc
+      cdata.set('HAVE_HEVC_ENC', 1)
+    endif
+endif
+
 if gstgl_dep.found()
   cdata.set ('HAVE_GST_GL', 1)
 endif
diff --git a/omx/meson.build b/omx/meson.build
index 2aff7a3..5e5ef84 100644
--- a/omx/meson.build
+++ b/omx/meson.build
@@ -53,6 +53,12 @@ endif
 
 if omx_target == 'rcar'
   omx_sources += 'gstomxh265dec.c'
+  if have_hevc_ext
+    omx_sources += 'gstomxh265utils.c'
+    if have_hevc_enc
+      omx_sources += 'gstomxh265enc.c'
+    endif
+  endif
   if have_mmngrbuf
     optional_deps += lib_mmngrbuf
   endif
-- 
2.25.1

