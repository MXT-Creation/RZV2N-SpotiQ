 #ifdef USE_OMX_TARGET_RPI
@@ -2671,39 +2670,6 @@ gst_omx_video_enc_set_format (GstVideoEncoder * encoder,
     port_def.format.video.xFramerate =
         gst_omx_video_calculate_framerate_q16 (info);
 
